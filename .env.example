# "db" funciona con docker compose local.
# En Vercel con Railway, reemplaza estos valores con los de tu base de datos Railway:
DATABASE_HOST=your-railway-host.railway.app
DATABASE_USER=root
DATABASE_PASSWORD=your_railway_password
DATABASE_NAME=railway
DATABASE_PORT=3306
JWT_SECRET_KEY=cambia_esto_por_un_secreto_largo_y_aleatorio